{
  "language": "en,en-US",
  "version": "0.2",
  "unknownWords": "report-common-typos",
  "ignorePaths": [
    "**/.cspell.json",
    "**/.dockerignore",
    "**/.gitignore",
    "**/.git/**",
    "**/node_modules/**",
    "**/pnpm-lock.yaml",
    ".github/workflows/*.yml"
  ],
  "ignoreRegExpList": [
    "/`+([\\s\\S]*?)`+/g",
    "/^```[\\s\\S]*?^```/gm",
    "/\\w*\\_\\w*/g",
    "/GHSA(-[0-9a-z]{4}){3}/g"
  ]
}
