{
  "language": "en,en-US",
  "version": "0.2",
  "ignorePaths": [
    "**/.cspell.json",
    "**/.dockerignore",
    "**/.gitignore",
    "**/.git/**",
    "**/node_modules/**",
    "**/pnpm-lock.yaml",
    ".github/workflows/*.yml"
  ],
  "ignoreRegExpList": [
    "/`+([\\s\\S]*?)`+/g",
    "/^```[\\s\\S]*?^```/gm",
    "/\\w*\\_\\w*/g",
    "/GHSA(-[0-9a-z]{4}){3}/g"
  ],
  "words": [
    "CCWM",
    "cooldown",
    "deepmerge",
    "distroless",
    "DPR",
    "glama",
    "istanbuljs",
    "MCP",
    "minimatch",
    "modelcontextprotocol",
    "nonroot",
    "offseason",
    "OPR",
    "unrs",
    "Vulns",
    "withinfocus",
    "zizmor"
  ]
}
