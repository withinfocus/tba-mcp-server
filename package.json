{
  "type": "module",
  "name": "@withinfocus/tba-mcp-server",
  "mcpName": "io.github.withinfocus/tba",
  "version": "1.5.0",
  "description": "The Blue Alliance MCP Server",
  "repository": {
    "type": "git",
    "url": "https://github.com/withinfocus/tba-mcp-server"
  },
  "author": "Matt Bishop <matt@withinfocus.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/withinfocus/tba-mcp-server/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "shx": "0.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.5.2",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/inspector": "2.16.0",
    "@playwright/test": "1.65.1",
    "@stylistic/eslint-plugin": "6.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.7",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "jest-junit": "17.0.0",
    "prettier": "3.10.1",
    "ts-jest": "29.4.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.74.0"
  },
  "packageManager": "pnpm@12.23.0",
  "bin": {
    "mcp-server-tba": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint . --cache --cache-strategy content && prettier --check .",
    "lint:fix": "eslint . --cache --cache-strategy content --fix",
    "build": "tsc && shx chmod +x dist/*.js",
    "inspect": "mcp-inspector node dist/index.js",
    "test": "jest --silent",
    "test:watch": "jest --watch",
    "test:unit": "jest --silent",
    "test:integration": "playwright test",
    "test:integration:ui": "playwright test --ui",
    "test:integration:debug": "playwright test --debug",
    "test:integration:headed": "playwright test --headed",
    "test:all": "pnpm run test:unit && pnpm run test:integration",
    "start:test": "node dist/index.js"
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  }
}
